# Meal Base local environment template
#
# The Solidity deployment workflow uses these values. The current static
# frontend does not load .env files; its Base RPC URL and contract address are
# constants in static/app.js.

# Base Mainnet JSON-RPC endpoint used by Foundry deployment commands.
BASE_RPC_URL=https://mainnet.base.org

# Private key for the deployer wallet. Never commit a real private key.
PRIVATE_KEY=your_deployer_private_key

# Optional: API key for contract verification services such as Basescan.
# The current deployment script does not require this value.
BASESCAN_API_KEY=your_basescan_api_key

# Frontend reference values. These are documentation-only until the static
# app is changed to read environment-specific configuration at build time.
CONTRACT_ADDRESS=0x7118e3327466FD1254bd848992fa8Eb9fBfE2d15
FRONTEND_RPC_URL=https://mainnet.base.org

# Example deployment command after copying this file to .env:
# source .env
# forge script script/DeployPlanner.s.sol:DeployPlanner \
#   --rpc-url "$BASE_RPC_URL" \
#   --private-key "$PRIVATE_KEY" \
#   --broadcast
